{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "5.0",
    "noEmitOnError": false,
    "baseUrl": ".",
    "paths": {
      "@dam/shared": ["packages/shared/src"],
      "@dam/shared/*": ["packages/shared/src/*"]
    }
  }
}
